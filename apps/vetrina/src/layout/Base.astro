---
import { NOME_PRODOTTO } from "../dati/config.ts";

interface Props {
  titolo: string;
  descrizione: string;
}

const { titolo, descrizione } = Astro.props;
const anno = new Date().getFullYear();

/**
 * `BASE_URL` di Astro segue `base` in astro.config.mjs: "/" in locale e sul
 * dominio di consegna, "/vetrina/" su GitHub Pages (i project site vivono in
 * sottocartella). Finisce sempre con "/", quindi si concatena senza slash
 * in mezzo: `${base}prezzi`, mai `${base}/prezzi`.
 */
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titolo}</title>
    <meta name="description" content={descrizione} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:title" content={titolo} />
    <meta property="og:description" content={descrizione} />
    <meta property="og:type" content="website" />

    <style is:global>
      :root {
        --primario: #1c2b4a;
        --accento: #c8622d;
        --sfondo: #fbfaf8;
        --superficie: #ffffff;
        --testo: #1a1d24;
        --tenue: color-mix(in srgb, var(--testo) 62%, transparent);
        --bordo: color-mix(in srgb, var(--testo) 14%, transparent);
        --font-titolo: "Georgia", "Times New Roman", serif;
        --font-corpo: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      }

      * {
        box-sizing: border-box;
      }
      html {
        overflow-x: hidden;
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        background: var(--sfondo);
        color: var(--testo);
        font-family: var(--font-corpo);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      h1, h2, h3 {
        font-family: var(--font-titolo);
        line-height: 1.15;
        text-wrap: balance;
      }
      a {
        color: inherit;
      }
      img {
        max-width: 100%;
        display: block;
      }

      .contenitore {
        max-width: 64rem;
        margin: 0 auto;
        padding-inline: 1.5rem;
      }

      .intestazione {
        border-bottom: 1px solid var(--bordo);
        background: var(--superficie);
      }
      .intestazione__barra {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-block: 1.1rem;
      }
      .intestazione__marchio {
        font-family: var(--font-titolo);
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--primario);
        text-decoration: none;
      }
      .intestazione__nav {
        display: flex;
        gap: 1.5rem;
        font-size: 0.95rem;
      }
      .intestazione__nav a {
        text-decoration: none;
        color: var(--tenue);
      }
      .intestazione__nav a:hover {
        color: var(--testo);
      }
      @media (max-width: 34rem) {
        .intestazione__nav {
          display: none;
        }
      }

      .pie {
        border-top: 1px solid var(--bordo);
        margin-top: 4rem;
        padding: 2.5rem 0;
        color: var(--tenue);
        font-size: 0.9rem;
      }
      .pie__righe {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        justify-content: space-between;
      }
      .pie a {
        color: var(--tenue);
      }

      /*
       * Il form arriva da @vetrina/form con la sola struttura e il minimo
       * funzionale (honeypot nascosto, colore dell'errore) — la stessa
       * ripartizione della regola 3: il template decide come appaiono i
       * campi, non come si spediscono. Stile qui, come nei due template.
       */
      .vetrina-form {
        display: grid;
        gap: 1.1rem;
      }
      .vetrina-form p {
        margin: 0;
      }
      .vetrina-form
        > p:not(.vetrina-form__errori):not(.vetrina-form__honeypot):not(:has(input[type="checkbox"])) {
        display: grid;
        gap: 0.4rem;
      }
      .vetrina-form label {
        font-size: 0.875rem;
        font-weight: 600;
      }
      .vetrina-form input:not([type="checkbox"]),
      .vetrina-form textarea {
        width: 100%;
        padding: 0.7rem 0.85rem;
        font: inherit;
        color: inherit;
        background: var(--sfondo);
        border: 1px solid var(--bordo);
        border-radius: 0.35rem;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
      }
      .vetrina-form textarea {
        resize: vertical;
        min-height: 6rem;
      }
      .vetrina-form input:not([type="checkbox"]):focus-visible,
      .vetrina-form textarea:focus-visible {
        outline: none;
        border-color: var(--accento);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--accento) 22%, transparent);
      }

      /*
       * Niente griglia sulla label del consenso: il consenso privacy contiene
       * quattro figli (casella, testo, link, versione) e una griglia a due
       * colonne li dispone uno per cella, spezzando la frase — trovato e
       * corretto in template-ristorante, stesso fix qui.
       */
      .vetrina-form p:has(input[type="checkbox"]) label {
        display: block;
        position: relative;
        padding-left: 1.75rem;
        font-size: 0.85rem;
        font-weight: 400;
        line-height: 1.45;
      }
      .vetrina-form input[type="checkbox"] {
        position: absolute;
        left: 0;
        top: 0.15rem;
        width: 1.05rem;
        height: 1.05rem;
        margin: 0;
        accent-color: var(--accento);
      }
      .vetrina-form a {
        color: var(--primario);
      }

      .vetrina-form button[type="submit"] {
        justify-self: start;
        min-height: 3rem;
        padding: 0.8rem 1.75rem;
        font: inherit;
        font-weight: 600;
        color: #fff;
        background: var(--accento);
        border: none;
        border-radius: 0.4rem;
        cursor: pointer;
        transition: transform 0.12s ease, box-shadow 0.15s ease;
      }
      .vetrina-form button[type="submit"]:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 18px color-mix(in srgb, var(--accento) 35%, transparent);
      }
      .vetrina-form button[type="submit"]:disabled {
        opacity: 0.5;
        cursor: progress;
        transform: none;
        box-shadow: none;
      }
      .vetrina-form__errori:not([hidden]) {
        padding: 0.7rem 0.85rem;
        font-size: 0.875rem;
        border-radius: 0.35rem;
        background: color-mix(in srgb, #b3261e 10%, transparent);
        border-left: 3px solid #b3261e;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }
    </style>
  </head>
  <body>
    <header class="intestazione">
      <div class="contenitore intestazione__barra">
        <a class="intestazione__marchio" href={base}>{NOME_PRODOTTO}</a>
        <nav class="intestazione__nav">
          <a href={`${base}#categorie`}>Template</a>
          <a href={`${base}prezzi`}>Prezzi</a>
          <a href={`${base}#contatto`}>Contatti</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="pie">
      <div class="contenitore pie__righe">
        <span>© {anno} {NOME_PRODOTTO}</span>
        <span>
          <a href={`${base}prezzi`}>Prezzi</a> · <a href={`${base}#contatto`}>Contatti</a> ·
          <a href={`${base}privacy`}>Privacy</a> · <a href={`${base}cookie`}>Cookie</a>
        </span>
      </div>
    </footer>
  </body>
</html>
