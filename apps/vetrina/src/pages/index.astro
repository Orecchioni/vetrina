---
import Form from "@vetrina/form";
import type { ConfigForm } from "@vetrina/schema";
import Base from "../layout/Base.astro";
import { CATALOGO, categorieDisponibili } from "../dati/catalogo.ts";
import { NOME_PRODOTTO, PREZZO, CONTATTO } from "../dati/config.ts";

const disponibili = categorieDisponibili();
const base = import.meta.env.BASE_URL;

/**
 * Il form di contatto del sito, con lo stesso componente condiviso dei
 * template (regola 3): questo sito è un cliente della propria pipeline di
 * ingestion, non un'eccezione. `id` e `sorgente` seguono la stessa
 * convenzione di forms.ts nei content.json.
 */
const configForm: ConfigForm = {
  id: "form_contatto_sito",
  sorgente: "contatto_home",
  campi_standard: ["nome", "email", "messaggio"],
  campi_extra: [],
  consenso_privacy: true,
  consenso_marketing: true,
};
---

<Base
  titolo={`${NOME_PRODOTTO} — un sito one-page per la tua attività`}
  descrizione="Un sito professionale, pronto in pochi giorni, per la tua attività locale. Scegli la categoria e guarda com'è fatto."
>
  <section class="eroe">
    <div class="contenitore eroe__interno">
      <h1 class="eroe__titolo">Il tuo sito, fatto bene, senza pensarci tu</h1>
      <p class="eroe__testo">
        Un sito one-page professionale per la tua attività: menù o servizi, orari,
        mappa, modulo di contatto. Lo costruiamo noi sui tuoi contenuti, tu lo
        approvi e va online.
      </p>
      <p class="eroe__prezzo">
        <span class="eroe__cifra">{PREZZO.valuta}{PREZZO.cifra}</span>
        <span class="eroe__nota">{PREZZO.nota}</span>
      </p>
      <a class="bottone bottone--grande" href="#categorie">Trova il tuo template</a>
    </div>
  </section>

  <section id="categorie" class="filtro">
    <div class="contenitore">
      <h2 class="filtro__domanda">Che tipo di attività hai?</h2>
      <p class="filtro__aiuto">
        Scegli la categoria, o scrivi cosa fai. {disponibili} categorie hanno già
        un template pronto da guardare, le altre stanno arrivando.
      </p>

      <input
        type="search"
        class="filtro__ricerca"
        placeholder="Scrivi la tua attività, es. pizzeria, dentista, idraulico…"
        data-ricerca
        aria-label="Cerca la tua attività"
      />

      <div class="filtro__chip" role="group" aria-label="Categorie">
        <button type="button" class="chip chip--attivo" data-chip="tutte">Tutte</button>
        {
          CATALOGO.map((c) => (
            <button type="button" class="chip" data-chip={c.slug}>
              {c.etichetta}
            </button>
          ))
        }
      </div>

      <div class="griglia" data-griglia>
        {
          CATALOGO.map((categoria) => (
            <article
              class="scheda"
              data-categoria={categoria.slug}
              data-termini={[categoria.etichetta, ...categoria.sinonimi].join(" ").toLowerCase()}
              data-pronto={categoria.template.length > 0 ? "si" : "no"}
            >
              <header class="scheda__testa">
                <h3 class="scheda__titolo">{categoria.etichetta}</h3>
                {categoria.template.length === 0 && (
                  <span class="scheda__stato">Presto disponibile</span>
                )}
              </header>

              {categoria.template.length > 0 ? (
                <ul class="scheda__template">
                  {categoria.template.map((t) => (
                    <li class="scheda__voce">
                      <div>
                        <p class="scheda__voce-nome">{t.nome}</p>
                        <p class="scheda__voce-desc">{t.descrizione}</p>
                      </div>
                      {t.demo ? (
                        <a class="bottone bottone--piccolo" href={t.demo} target="_blank" rel="noopener">
                          Guarda la demo
                        </a>
                      ) : (
                        <span class="scheda__demo-attesa">Demo in arrivo</span>
                      )}
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="scheda__vuoto">
                  Stiamo preparando il template per questa categoria. Lascia un
                  contatto sotto e ti avvisiamo appena è pronto.
                </p>
              )}
            </article>
          ))
        }
      </div>

      <p class="filtro__nessuno" data-nessuno hidden>
        Nessuna categoria corrisponde. Scrivici sotto cosa fai: probabilmente
        possiamo comunque aiutarti.
      </p>
    </div>
  </section>

  <section id="contatto" class="contatto">
    <div class="contenitore contatto__griglia">
      <div class="contatto__testata">
        <h2 class="contatto__titolo">Non trovi la tua categoria, o hai una domanda?</h2>
        <p class="contatto__testo">
          Scrivici che attività hai e cosa ti serve. Ti rispondiamo con una
          proposta e, se il template non c'è ancora, ti diciamo quando arriva.
        </p>
        <a class="bottone" href={`${base}prezzi`}>Vedi cosa è incluso</a>
      </div>
      <div class="contatto__form">
        <Form
          config={configForm}
          tenantId={CONTATTO.tenant_id}
          endpoint={CONTATTO.endpoint}
          informativaVersione={CONTATTO.informativa_versione}
          informativaUrl={`${base}privacy`}
        />
      </div>
    </div>
  </section>
</Base>

<style>
  .eroe {
    background: var(--primario);
    color: #fff;
    padding-block: clamp(3.5rem, 10vw, 6rem);
  }
  .eroe__interno {
    max-width: 40rem;
  }
  .eroe__titolo {
    font-size: clamp(2.1rem, 6vw, 3.4rem);
    margin: 0 0 1rem;
  }
  .eroe__testo {
    font-size: clamp(1.05rem, 2.5vw, 1.25rem);
    opacity: 0.9;
    margin: 0 0 1.75rem;
  }
  .eroe__prezzo {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin: 0 0 2rem;
  }
  .eroe__cifra {
    font-family: var(--font-titolo);
    font-size: 2.4rem;
    font-weight: 700;
    color: #fff;
  }
  .eroe__nota {
    color: color-mix(in srgb, #fff 78%, transparent);
    font-size: 0.95rem;
  }

  .bottone {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.8rem 1.75rem;
    background: var(--accento);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    border: none;
    border-radius: 0.4rem;
    cursor: pointer;
    font-size: 1rem;
    transition: transform 0.12s ease, box-shadow 0.15s ease;
  }
  .bottone:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 18px color-mix(in srgb, var(--accento) 35%, transparent);
  }
  .bottone--grande {
    font-size: 1.1rem;
    padding: 0.95rem 2.25rem;
  }
  .bottone--piccolo {
    min-height: 2.4rem;
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .filtro {
    padding-block: clamp(3rem, 8vw, 5rem);
  }
  .filtro__domanda {
    font-size: clamp(1.6rem, 5vw, 2.4rem);
    color: var(--primario);
    margin: 0 0 0.5rem;
  }
  .filtro__aiuto {
    color: var(--tenue);
    margin: 0 0 1.75rem;
    max-width: 42rem;
  }
  .filtro__ricerca {
    width: 100%;
    max-width: 34rem;
    padding: 0.85rem 1rem;
    font: inherit;
    border: 1px solid var(--bordo);
    border-radius: 0.4rem;
    background: var(--superficie);
    margin-bottom: 1.25rem;
  }
  .filtro__ricerca:focus-visible {
    outline: none;
    border-color: var(--accento);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accento) 20%, transparent);
  }

  .filtro__chip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .chip {
    padding: 0.45rem 0.9rem;
    font: inherit;
    font-size: 0.9rem;
    background: var(--superficie);
    border: 1px solid var(--bordo);
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.12s ease, border-color 0.12s ease, color 0.12s ease;
  }
  .chip:hover {
    border-color: var(--accento);
  }
  .chip--attivo {
    background: var(--primario);
    border-color: var(--primario);
    color: #fff;
  }

  .griglia {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) {
    .griglia {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .scheda {
    background: var(--superficie);
    border: 1px solid var(--bordo);
    border-radius: 0.6rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .scheda[hidden] {
    display: none;
  }
  .scheda__testa {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .scheda__titolo {
    font-size: 1.2rem;
    margin: 0;
    color: var(--primario);
  }
  .scheda__stato {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accento);
    white-space: nowrap;
  }
  .scheda__template {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .scheda__voce {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .scheda__voce-nome {
    font-weight: 600;
    margin: 0 0 0.15rem;
  }
  .scheda__voce-desc {
    margin: 0;
    font-size: 0.9rem;
    color: var(--tenue);
  }
  .scheda__demo-attesa {
    font-size: 0.85rem;
    color: var(--tenue);
    white-space: nowrap;
  }
  .scheda__vuoto {
    margin: 0;
    font-size: 0.92rem;
    color: var(--tenue);
  }

  .filtro__nessuno {
    margin-top: 1.5rem;
    color: var(--tenue);
  }

  .contatto {
    background: color-mix(in srgb, var(--primario) 6%, var(--sfondo));
    border-top: 1px solid var(--bordo);
    padding-block: clamp(3rem, 8vw, 4.5rem);
  }
  .contatto__griglia {
    display: grid;
    gap: clamp(2rem, 5vw, 3rem);
    align-items: start;
  }
  @media (min-width: 48rem) {
    .contatto__griglia {
      grid-template-columns: 1fr 1fr;
    }
  }
  .contatto__testata {
    max-width: 32rem;
  }
  .contatto__titolo {
    font-size: clamp(1.5rem, 4.5vw, 2.1rem);
    color: var(--primario);
    margin: 0 0 0.75rem;
  }
  .contatto__testo {
    color: var(--tenue);
    margin: 0 0 1.75rem;
  }
  .contatto__form {
    background: var(--superficie);
    border: 1px solid var(--bordo);
    border-radius: 0.6rem;
    padding: clamp(1.25rem, 4vw, 1.75rem);
  }
</style>

<script>
  /*
   * La domanda filtro del §6.1, lato client: i chip di categoria e il campo di
   * ricerca nascondono o mostrano le schede. Tutto il contenuto è già nel DOM
   * (sito statico, ottimo per la SEO locale del §14.3): il filtro toglie, non
   * carica. Se JS non parte, si vedono comunque tutte le categorie.
   */
  const griglia = document.querySelector<HTMLElement>("[data-griglia]");
  const schede = Array.from(document.querySelectorAll<HTMLElement>(".scheda"));
  const chip = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-chip]"));
  const ricerca = document.querySelector<HTMLInputElement>("[data-ricerca]");
  const nessuno = document.querySelector<HTMLElement>("[data-nessuno]");

  let categoriaAttiva = "tutte";

  function applica(): void {
    const testo = (ricerca?.value ?? "").trim().toLowerCase();
    let visibili = 0;

    for (const scheda of schede) {
      const slug = scheda.dataset.categoria ?? "";
      const termini = scheda.dataset.termini ?? "";

      const passaCategoria = categoriaAttiva === "tutte" || categoriaAttiva === slug;
      const passaTesto = testo === "" || termini.includes(testo);
      const mostra = passaCategoria && passaTesto;

      scheda.hidden = !mostra;
      if (mostra) visibili++;
    }

    if (nessuno) nessuno.hidden = visibili > 0;
    if (griglia) griglia.hidden = visibili === 0;
  }

  for (const c of chip) {
    c.addEventListener("click", () => {
      categoriaAttiva = c.dataset.chip ?? "tutte";
      for (const altro of chip) altro.classList.toggle("chip--attivo", altro === c);
      // Scrivere nel campo di ricerca insieme al chip confonderebbe: il chip
      // filtra per categoria, la ricerca per testo. Restano due assi separati.
      applica();
    });
  }

  ricerca?.addEventListener("input", () => {
    // Digitare libera il vincolo di categoria: chi scrive "pizzeria" non vuole
    // restare bloccato sul chip cliccato prima.
    if (ricerca.value.trim() !== "" && categoriaAttiva !== "tutte") {
      categoriaAttiva = "tutte";
      for (const altro of chip) altro.classList.toggle("chip--attivo", altro.dataset.chip === "tutte");
    }
    applica();
  });
</script>
